# 复制成 demo\.env，再填入真实 key。.env 已写进 .gitignore，不要提交或发给别人。
#   PowerShell:  Copy-Item .env.example .env
# 也可以只在终端里设置（优先级高于 .env）：
#   PowerShell:  $env:ANTHROPIC_API_KEY = "sk-ant-..."

# 必填
ANTHROPIC_API_KEY=

# 可选：换模型，默认 claude-opus-5-5
DEMO_MODEL=claude-opus-5-5

# 可选：运行时文件的位置，默认 demo\runtime
# DESK_RUNTIME=
