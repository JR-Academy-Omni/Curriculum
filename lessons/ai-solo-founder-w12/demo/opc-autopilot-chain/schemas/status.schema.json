{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "阶段回执",
  "type": "object",
  "required": ["stage", "date", "status", "reason", "outputs"],
  "properties": {
    "stage": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["done", "skipped", "needs-human"] },
    "reason": { "type": "string", "description": "done 时写一句做了什么；其他状态写清原因" },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" }, "description": "来源 URL 或可核对的依据" }
  }
}
